# Copy this file to `.env` and fill in your key. NEVER commit `.env`.
# Get a key at https://console.anthropic.com/



# Optional: override the model id (must be a valid current Anthropic model).
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: run the whole app offline — recorded market data AND recorded AI
# output, no key and no network. For local demos / CI. Leave unset in production.
# USE_MOCK=1

# Optional, finer grained. Each overrides its own axis and BEATS USE_MOCK.
#   USE_MOCK_DATA=1  recorded market data (market_data/fixtures/), live AI.
#                    Frozen input, so an output change is the prompt's doing —
#                    the mode to use while iterating on prompts.
#   USE_MOCK_LLM=1   live market data, recorded AI output.
# Re-record the snapshot with:  python -m market_data.refresh
# USE_MOCK_DATA=1
# USE_MOCK_LLM=1
