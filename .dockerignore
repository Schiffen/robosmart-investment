# Keep the image small and the build fast. The app needs none of this.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.github/

# Secrets never belong in a build context. .env is gitignored so it should not
# be here at all — this is belt and braces.
.env
.env.*
.streamlit/secrets.toml

# Development-only artefacts.
#
# docs/ wholesale: nothing under it is read at runtime, and it carries the
# screenshots and the summary PDF (~1.7MB). logos/ is NOT here — brand.py reads
# those SVGs on every run and inlines them.
_preview_app.py
tests/
docs/
.claude/
.impeccable/
.impeccable-critique-shots/
assets/candidates/

# The synthetic dev stand-in's recorded context (372KB). The shipped offline
# mode replays market_data/fixtures/ instead, so nothing in the running app
# opens this.
fixtures/mock_context.json

# Local noise
*.log
preview_*.png
.DS_Store
